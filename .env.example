# Server deployment behind a reverse proxy. Copy to .env next to
# docker-compose.yml. Local use needs no .env at all.

# Add the proxy network on top of the base compose file.
COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml

# Sub-path the app is served from.
BASE_PATH=/chess/

# Existing Docker network of the proxy container.
PROXY_NETWORK=nginx_frontend_net
