{
  "name": "gambit-chess",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:server",
    "preview": "vite preview",
    "postinstall": "node scripts/copy-engine.mjs",
    "engine:copy": "node scripts/copy-engine.mjs",
    "test": "vitest run",
    "build:server": "vite build --ssr server/index.ts --outDir dist-server --emptyOutDir",
    "start": "node dist-server/index.js",
    "dev:server": "npm run build:server && node dist-server/index.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "chess.js": "^1.4.0",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stockfish": "^19.0.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
